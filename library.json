{
  "$schema": "https://raw.githubusercontent.com/platformio/platformio-core/develop/platformio/assets/schema/library.json",
  "name": "ESPMeshMesh",
  "version": "1.6.9",
  "description": "ESPMeshMesh implementation",
  "keywords": "mesh, network",
  "repository": {
    "type": "git",
    "url": "https://github.com/EspMeshMesh/espmeshmesh.git"
  },
  "authors": [
    {
      "name": "Stefano Pagnottelli",
      "email": "dev@espmeshmesh.org",
      "url": "https://www.espmeshmesh.org/"
    }
  ],
  "license": "BSD-2-Clause",
  "homepage": "https://www.espmeshmesh.org/",
  "dependencies": {
    "nanopb/Nanopb": "^0.4.91"
  },
  "frameworks": "*",
  "platforms": [
    "espressif32",
    "espressif8266"
  ],
  "build": {
    "flags": [
      "-DESPMESHMESH_VERSION=1.6.9",
      "-Wl,-zmuldefs"
    ]
  },
  "ESPHOME": {
    "NOTE": "IDF REQUIRES for esp_wifi/esp_phy/... are injected by esphome-meshmesh components/meshmesh/__init__.py (_ensure_espmeshmesh_idf_wifi_stack) because ESPHome 2026.7+ PIO\u2192IDF conversion only maps library.json PIO dependencies into REQUIRES."
  }
}
